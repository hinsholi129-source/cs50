import 'package:flutter/material.dart';
import 'package:diskusifihk/discussion_repository.dart';
import 'package:diskusifihk/models/discussion.dart';
import 'package:diskusifihk/screens/detail_screen.dart';
import 'package:diskusifihk/screens/add_discussion_screen.dart';

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final DiscussionRepository _repository = DiscussionRepository();
  String? _currentUserId;
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadData();
  }

  Future<void> _loadData() async {
    setState(() => _isLoading = true);
    try {
      await _repository.init();
      final userId = await _repository.getCurrentUserId();
      if (mounted) {
        setState(() {
          _currentUserId = userId;
          _isLoading = false;
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() => _isLoading = false);
      }
    }
  }

  Future<void> _refreshData() async {
    await _loadData();
  }

  void _toggleLikeDiscussion(String discussionId) {
    final discussion = _repository.discussions.firstWhere(
      (d) => d.id == discussionId,
      orElse: () => throw Exception('Discussion not found'),
    );
    setState(() {
      discussion.likeCount = discussion.likeCount > 0 ? discussion.likeCount - 1 : discussion.likeCount + 1;
    });
    _repository._saveToPrefs();
  }

  void _showEditDiscussionDialog(Discussion discussion) {
    final titleController = TextEditingController(text: discussion.title);
    final contentController = TextEditingController(text: discussion.content);
    String selectedCategory = discussion.category;

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Edit Topik'),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(
                controller: titleController,
                decoration: const InputDecoration(labelText: 'Judul Topik'),
              ),
              const SizedBox(height: 16),
              DropdownButtonFormField<String>(
                decoration: const InputDecoration(labelText: 'Kategori'),
                value: selectedCategory,
                items: const [
                  'Fiqih Ibadah',
                  'Fiqih Muamalah',
                  'Fiqih Jinayah',
                  'Fiqih Keluarga',
                ].map((String category) {
                  return DropdownMenuItem<String>(
                    value: category,
                    child: Text(category),
                  );
                }).toList(),
                onChanged: (String? newValue) {
                  selectedCategory = newValue!;
                },
              ),
              const SizedBox(height: 16),
              TextField(
                controller: contentController,
                decoration: const InputDecoration(labelText: 'Isi Topik'),
                minLines: 4,
                maxLines: 8,
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Batal'),
          ),
          ElevatedButton(
            onPressed: () {
              if (titleController.text.isNotEmpty && contentController.text.isNotEmpty) {
                setState(() {
                  discussion.title = titleController.text;
                  discussion.content = contentController.text;
                  discussion.category = selectedCategory;
                });
                _repository._saveToPrefs();
                Navigator.of(context).pop();
              }
            },
            child: const Text('Simpan'),
          ),
        ],
      ),
    );
  }

  void _confirmDeleteDiscussion(String discussionId) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Hapus Topik'),
        content: const Text('Apakah Anda yakin ingin menghapus topik ini?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Batal'),
          ),
          ElevatedButton(
            onPressed: () {
              setState(() {
                _repository.discussions.removeWhere((d) => d.id == discussionId);
              });
              _repository._saveToPrefs();
              Navigator.of(context).pop();
            },
            child: const Text('Hapus'),
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Diskusi Fiqih Kontemporer'),
      ),
      body: _isLoading
          ? const Center(
              child: CircularProgressIndicator(),
            )
          : RefreshIndicator(
              onRefresh: _refreshData,
              child: _repository.discussions.isEmpty
                  ? _buildEmptyState()
                  : ListView.builder(
                      itemCount: _repository.discussions.length,
                      itemBuilder: (context, index) {
                        final discussion = _repository.discussions[index];
                        final bool isOwner = discussion.userId == _currentUserId;
                        
                        return DiscussionCard(
                          discussion: discussion,
                          onTap: () {
                            Navigator.of(context).push(
                              MaterialPageRoute(
                                builder: (_) => DetailScreen(discussionId: discussion.id),
                              ),
                            );
                          },
                          onLikeToggle: _toggleLikeDiscussion,
                          isOwner: isOwner,
                          onEdit: isOwner ? () => _showEditDiscussionDialog(discussion) : null,
                          onDelete: isOwner ? () => _confirmDeleteDiscussion(discussion.id) : null,
                        );
                      },
                    ),
            ),
      floatingActionButton: FloatingActionButton(
        onPressed: () {
          Navigator.of(context).push(
            MaterialPageRoute(
              builder: (_) => const AddDiscussionScreen()),
          );
        },
        child: const Icon(Icons.add),
      ),
    );
  }

  Widget _buildEmptyState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Icon(
            Icons.chat_bubble_outline,
            size: 64,
            color: Colors.grey,
          ),
          const SizedBox(height: 16),
          const Text(
            'Belum ada diskusi',
            style: TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.bold,
              color: Colors.grey,
            ),
          ),
          const SizedBox(height: 8),
          const Text(
            'Mari mulailah diskusi pertama Anda!',
            style: TextStyle(
              fontSize: 14,
              color: Colors.grey[600],
            ),
          ),
          const SizedBox(height: 24),
          ElevatedButton.icon(
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (_) => const AddDiscussionScreen()),
              );
            },
            icon: const Icon(Icons.add),
            label: const Text('Buat Diskusi'),
          ),
        ],
      ),
    );
  }
}

class DiscussionCard extends StatelessWidget {
  final Discussion discussion;
  final VoidCallback onTap;
  final VoidCallback onLikeToggle;
  final bool isOwner;
  final VoidCallback? onEdit;
  final VoidCallback? onDelete;

  const DiscussionCard({
    super.key,
    required this.discussion,
    required this.onTap,
    required this.onLikeToggle,
    this.isOwner = false,
    this.onEdit,
    this.onDelete,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      child: ListTile(
        contentPadding: const EdgeInsets.all(16),
        title: Text(
          discussion.title,
          style: Theme.of(context).textTheme.titleLarge,
        ),
        subtitle: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: 4),
            Text(
              discussion.content,
              maxLines: 2,
              overflow: TextOverflow.ellipsis,
              style: Theme.of(context).textTheme.bodyMedium,
            ),
            const SizedBox(height: 8),
            Row(
              children: [
                Chip(
                  label: Text(discussion.category),
                ),
                const Spacer(),
                Text(
                  '${discussion.commentCount} Komentar',
                  style: Theme.of(context).textTheme.labelSmall,
                ),
              ],
            ),
          ],
        ),
        trailing: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            if (isOwner) ...[
              PopupMenuButton<String>(
                onSelected: (value) {
                  if (value == 'edit' && onEdit != null) onEdit!();
                  if (value == 'delete' && onDelete != null) onDelete!();
                },
                itemBuilder: (context) => [
                  const PopupMenuItem(
                    value: 'edit',
                    child: Text('Edit'),
                  ),
                  const PopupMenuItem(
                    value: 'delete',
                    child: const Text(
                      'Hapus',
                      style: TextStyle(color: Colors.red),
                    ),
                  ),
                ],
                icon: const Icon(Icons.more_vert),
                offset: const Offset(0, 30),
              ),
              const SizedBox(width: 8),
            ],
            IconButton(
              icon: Icon(
                discussion.likeCount > 0 ? Icons.favorite : Icons.favorite_border,
                color: discussion.likeCount > 0 ? Colors.red : null,
              ),
              onPressed: onLikeToggle,
            ),
            Text(
              '${discussion.likeCount}',
              style: Theme.of(context).textTheme.labelSmall,
            ),
            const SizedBox(width: 8),
            const Icon(Icons.arrow_forward_ios),
          ],
        ),
        onTap: onTap,
      ),
    );
  }
}
