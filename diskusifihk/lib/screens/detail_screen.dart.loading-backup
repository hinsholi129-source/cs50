import 'package:flutter/material.dart';
import 'package:diskusifihk/discussion_repository.dart';
import 'package:diskusifihk/models/discussion.dart';
import 'package:diskusifihk/models/comment.dart';

class DetailScreen extends StatefulWidget {
  final String discussionId;

  const DetailScreen({super.key, required this.discussionId});

  @override
  State<DetailScreen> createState() => _DetailScreenState();
}

class _DetailScreenState extends State<DetailScreen> {
  final DiscussionRepository _repository = DiscussionRepository();
  final _commentController = TextEditingController();

  Discussion? _discussion;
  String? _currentUserId;

  @override
  void initState() {
    super.initState();
    _loadDiscussion();
    _loadCurrentUserId();
  }

  void _loadDiscussion() {
    final discussion = _repository.discussions.firstWhere(
      (d) => d.id == widget.discussionId,
      orElse: () => throw Exception('Discussion not found'),
    );
    setState(() {
      _discussion = discussion;
    });
  }

  Future<void> _loadCurrentUserId() async {
    final userId = await _repository.getCurrentUserId();
    if (mounted) {
      setState(() {
        _currentUserId = userId;
      });
    }
  }

  void _toggleLikeComment(String discussionId, String commentId) {
    final discussion = _repository.discussions.firstWhere(
      (d) => d.id == discussionId,
      orElse: () => throw Exception('Discussion not found'),
    );
    
    final comment = discussion.comments.firstWhere(
      (c) => c.id == commentId,
      orElse: () => throw Exception('Comment not found'),
    );
    
    setState(() {
      comment.likeCount = comment.likeCount > 0 ? comment.likeCount - 1 : comment.likeCount + 1;
    });
    
    // Save to preferences
    _repository._saveToPrefs();
  }

  void _editComment(String discussionId, Comment comment) {
    final controller = TextEditingController(text: comment.content);
    
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Edit Komentar'),
        content: TextField(
          controller: controller,
          decoration: const InputDecoration(
            labelText: 'Komentar',
            border: OutlineInputBorder(),
          ),
          maxLines: 4,
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Batal'),
          ),
          ElevatedButton(
            onPressed: () {
              if (controller.text.isNotEmpty) {
                setState(() {
                  comment.content = controller.text;
                });
                _repository._saveToPrefs();
                Navigator.of(context).pop();
              }
            },
            child: const Text('Simpan'),
          ),
        ],
      ),
    );
  }

  void _deleteComment(String discussionId, Comment comment) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Hapus Komentar'),
        content: const Text('Apakah Anda yakin ingin menghapus komentar ini?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Batal'),
          ),
          ElevatedButton(
            onPressed: () {
              setState(() {
                _discussion!.comments.removeWhere((c) => c.id == comment.id);
              });
              _repository._saveToPrefs();
              Navigator.of(context).pop();
            },
            child: const Text('Hapus'),
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
          ),
        ],
      ),
    );
  }

  void _addComment() {
    final content = _commentController.text.trim();
    if (content.isEmpty) return;
    
    // Use current user ID, fallback to placeholder if not available
    final userId = _currentUserId ?? 'fallback_user';
    
    final comment = Comment(
      id: 'comment_${DateTime.now().millisecondsSinceEpoch}',
      content: content,
      userId: userId,
      likeCount: 0,
    );
    _repository.addComment(widget.discussionId, comment);
    setState(() {});
    _commentController.clear();
  }

  @override
  Widget build(BuildContext context) {
    if (_discussion == null) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: Text(_discussion!.title),
      ),
      body: Column(
        children: [
          Expanded(
            child: ListView(
              padding: const EdgeInsets.all(16),
              children: [
                Text(
                  _discussion!.content,
                  style: Theme.of(context).textTheme.bodyLarge,
                ),
                const Divider(height: 32),
                const Text(
                  'Komentar',
                  style: TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 8),
                ..._discussion!.comments.map((comment) => CommentTile(
                  comment: comment,
                  onLikeToggle: () => _toggleLikeComment(_discussion!.id, comment.id),
                  onEdit: () => _editComment(_discussion!.id, comment),
                  onDelete: () => _deleteComment(_discussion!.id, comment),
                )).toList(),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(16),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _commentController,
                    decoration: const InputDecoration(
                      labelText: 'Tambahkan komentar...',
                      border: OutlineInputBorder(),
                    ),
                    maxLines: null,
                  ),
                ),
                const SizedBox(width: 8),
                IconButton(
                  onPressed: _addComment,
                  icon: const Icon(Icons.send),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

class CommentTile extends StatelessWidget {
  final Comment comment;
  final VoidCallback onLikeToggle;
  final VoidCallback? onEdit;
  final VoidCallback? onDelete;

  const CommentTile({
    super.key,
    required this.comment,
    required this.onLikeToggle,
    this.onEdit,
    this.onDelete,
  });

  @override
  Widget build(BuildContext context) {
    return ListTile(
      contentPadding: EdgeInsets.zero,
      title: Text(
        comment.content,
        style: Theme.of(context).textTheme.bodyMedium,
      ),
      subtitle: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            '${comment.timestamp.day}/${comment.timestamp.month}/${comment.timestamp.year} ${comment.timestamp.hour}:${comment.timestamp.minute}',
            style: Theme.of(context).textTheme.labelSmall,
          ),
          const SizedBox(height: 4),
          Row(
            mainAxisAlignment: MainAxisSpaceBetween,
            children: [
              Row(
                children: [
                  IconButton(
                    icon: Icon(
                      comment.likeCount > 0 ? Icons.favorite : Icons.favorite_border,
                      color: comment.likeCount > 0 ? Colors.red : null,
                    ),
                    onPressed: onLikeToggle,
                  ),
                  Text(
                    '${comment.likeCount}',
                    style: Theme.of(context).textTheme.labelSmall,
                  ),
                ],
              ),
              if (onEdit != null || onDelete != null) ...[
                PopupMenuButton<String>(
                  onSelected: (value) {
                    if (value == 'edit' && onEdit != null) onEdit!();
                    if (value == 'delete' && onDelete != null) onDelete!();
                  },
                  itemBuilder: (context) => [
                    if (onEdit != null)
                      const PopupMenuItem(
                        value: 'edit',
                        child: Text('Edit'),
                      ),
                    if (onDelete != null)
                      const PopupMenuItem(
                        value: 'delete',
                        child: Text(
                          'Hapus',
                          style: TextStyle(color: Colors.red),
                        ),
                      ),
                  ],
                  icon: const Icon(Icons.more_vert),
                  offset: const Offset(0, 30),
                ),
              ],
            ],
          ),
        ],
      ),
    );
  }
}
